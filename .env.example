# Database
DB_PATH=data/pipeline.db

# Chrome remote debugging port
CHROME_DEBUG_PORT=9222

# Daily API budgets (per resource, per day)
BUDGET_GEMINI=50
BUDGET_ADZUNA=500
BUDGET_SERP=100
BUDGET_BRAVE=150
BUDGET_PLAYWRIGHT=200
BUDGET_SMTP=50
BUDGET_HTTPX=2000
BUDGET_DDG=200

# Circuit breaker defaults
CB_FAILURE_THRESHOLD=5
CB_DEFAULT_COOLDOWN_HOURS=4

# Scoring thresholds
MIN_FIT_SCORE=0.35
HIGH_PRIORITY_SCORE=0.60
MAX_HIGH_PRIORITY=30

# Adzuna API (optional)
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Logging
LOG_LEVEL=INFO
